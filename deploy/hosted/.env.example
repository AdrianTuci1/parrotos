# Configuration for a hosted Parrot deployment. Copy to .env and fill in.
#
#   cp .env.example .env
#
# STATSPARROT_SERVE_* configures the deployment as a whole. STATSPARROT_ADMIN_* and
# STATSPARROT_RUNTIME_* are passed through to the two processes unchanged.

# ─── Where the deployment is reachable ───────────────────────────────────────
# The origin users open in a browser. Must be https in production, and its host must match
# STATSPARROT_DOMAIN. With deploy/terraform/lightsail:
#   terraform output -raw public_url -> STATSPARROT_SERVE_PUBLIC_URL
#   terraform output -raw hostname   -> STATSPARROT_DOMAIN
STATSPARROT_SERVE_PUBLIC_URL=https://bi.example.com
STATSPARROT_DOMAIN=bi.example.com

# Processes to run in the container: all (default), admin or runtime.
# STATSPARROT_SERVE_ROLE=all

# The runtime's private port, the path prefix it is exposed under, and how many projects one
# runtime serves. Raise the slot count on a bigger host.
# STATSPARROT_SERVE_RUNTIME_PORT=9009
# STATSPARROT_SERVE_RUNTIME_PATH=/runtime
# STATSPARROT_SERVE_RUNTIME_SLOTS=1000

# Set when the admin and the runtime run as separate containers. A provisioner spec that is set
# to an empty value stops the deployment from generating its own, so fill it in or leave the line
# commented out.
# STATSPARROT_SERVE_RUNTIME_TARGET=http://runtime:9009
# STATSPARROT_ADMIN_PROVISIONER_SET_JSON=<provisioner spec json>

# Where per-project data lives and how long a process gets to shut down.
# STATSPARROT_SERVE_RUNTIME_DATA_DIR=/var/lib/statsparrot
# STATSPARROT_RUNTIME_DATA_DIR=/var/lib/statsparrot
# STATSPARROT_SERVE_DRAIN_TIMEOUT=30s
# The runtime keeps deployments and instances in a SQLite file inside DATA_DIR. For several
# runtime replicas, point it at the same Postgres as the admin server instead, and give every
# replica the same STATSPARROT_RUNTIME_METASTORE_ID.
# STATSPARROT_RUNTIME_METASTORE_DRIVER=postgres
# STATSPARROT_RUNTIME_METASTORE_URL=postgres://user:password@db.example.com:5432/statsparrot?sslmode=require
# STATSPARROT_RUNTIME_METASTORE_ID=statsparrot

# ─── Database (required) ─────────────────────────────────────────────────────
# A managed Postgres 14+ instance, not part of this compose file. Holds accounts, organizations,
# projects and the job queue. Create it empty: the admin server migrates on boot.
STATSPARROT_ADMIN_DATABASE_URL=postgres://user:password@db.example.com:5432/statsparrot?sslmode=require
STATSPARROT_ADMIN_RIVER_DATABASE_URL=postgres://user:password@db.example.com:5432/statsparrot?sslmode=require

# Optional. Rate limiting and query caching, with per-process fallbacks.
# STATSPARROT_ADMIN_REDIS_URL=redis://redis.example.com:6379
# STATSPARROT_RUNTIME_REDIS_URL=redis://redis.example.com:6379

# ─── Secrets (required) ──────────────────────────────────────────────────────
# Sign the browser session cookie and the runtime's download tokens. openssl rand -hex 32
# Comma-separate several to rotate: the first signs, the rest still verify.
STATSPARROT_ADMIN_SESSION_KEY_PAIRS=replace-me
STATSPARROT_RUNTIME_SESSION_KEY_PAIRS=replace-me

# The key the admin server signs runtime tokens with:
#   statsparrot admin generate-signing-key
# The runtime fetches the public half from {STATSPARROT_SERVE_PUBLIC_URL}/.well-known/jwks.json.
STATSPARROT_ADMIN_SIGNING_JWKS={"keys":[]}
STATSPARROT_ADMIN_SIGNING_KEY_ID=replace-me

# Encrypts stored connector credentials: [{"key_id":"1","key":"<openssl rand -base64 32>"}]
# STATSPARROT_ADMIN_DATABASE_ENCRYPTION_KEYRING=[{"key_id":"1","key":"replace-me"}]

# ─── Authentication (required) ───────────────────────────────────────────────
# Any OIDC provider. Hostname only; the discovery document is read from
# https://{domain}/.well-known/openid-configuration.
# Register {STATSPARROT_SERVE_PUBLIC_URL}/auth/login/callback as a redirect URI.
STATSPARROT_ADMIN_AUTH_DOMAIN=your-tenant.example.com
STATSPARROT_ADMIN_AUTH_CLIENT_ID=replace-me
STATSPARROT_ADMIN_AUTH_CLIENT_SECRET=replace-me

# ─── Object storage (required) ───────────────────────────────────────────────
# Organization branding and project archives. Two drivers:
#
#   gcs  STATSPARROT_ADMIN_ASSETS_BUCKET plus either application default credentials or
#        STATSPARROT_ADMIN_ASSETS_BUCKET_GOOGLE_CREDENTIALS_JSON
#   s3   STATSPARROT_ADMIN_ASSETS_BUCKET plus the S3_* values below. Works with AWS S3,
#        Cloudflare R2, MinIO and anything else that speaks the S3 API. On AWS the instance role
#        is used when no key is set, so the S3_* block can stay empty there.
#
# R2: endpoint https://<account_id>.r2.cloudflarestorage.com, region auto.
# MinIO: the server's URL and force_path_style true.
STATSPARROT_ADMIN_ASSETS_DRIVER=gcs
STATSPARROT_ADMIN_ASSETS_BUCKET=your-assets-bucket
# STATSPARROT_ADMIN_ASSETS_BUCKET_GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}
# STATSPARROT_ADMIN_ASSETS_S3_REGION=auto
# STATSPARROT_ADMIN_ASSETS_S3_ENDPOINT=https://account_id.r2.cloudflarestorage.com
# STATSPARROT_ADMIN_ASSETS_S3_ACCESS_KEY_ID=replace-me
# STATSPARROT_ADMIN_ASSETS_S3_SECRET_ACCESS_KEY=replace-me
# STATSPARROT_ADMIN_ASSETS_S3_FORCE_PATH_STYLE=false

# ─── Email (optional) ────────────────────────────────────────────────────────
# Without SMTP, emails are logged to stdout instead of sent.
# STATSPARROT_ADMIN_EMAIL_SMTP_HOST=smtp.example.com
# STATSPARROT_ADMIN_EMAIL_SMTP_PORT=587
# STATSPARROT_ADMIN_EMAIL_SMTP_USERNAME=replace-me
# STATSPARROT_ADMIN_EMAIL_SMTP_PASSWORD=replace-me
# STATSPARROT_ADMIN_EMAIL_SENDER_EMAIL=no-reply@example.com
# STATSPARROT_ADMIN_EMAIL_SENDER_NAME=Parrot
# STATSPARROT_RUNTIME_EMAIL_SENDER_EMAIL=no-reply@example.com
# STATSPARROT_RUNTIME_EMAIL_SENDER_NAME=Parrot

# ─── The AI agent (optional) ─────────────────────────────────────────────────
# Without a key the agent answers in mock mode.
# STATSPARROT_ADMIN_AI_DRIVER=openai
# STATSPARROT_ADMIN_OPENAI_API_KEY=replace-me
# STATSPARROT_ADMIN_CLAUDE_API_KEY=replace-me
# STATSPARROT_ADMIN_GEMINI_API_KEY=replace-me

# ─── GitHub App (optional) ───────────────────────────────────────────────────
# Only for projects connected to a GitHub repository. `statsparrot deploy --managed` needs none
# of these.
# STATSPARROT_ADMIN_GITHUB_APP_ID=
# STATSPARROT_ADMIN_GITHUB_APP_PRIVATE_KEY=
# STATSPARROT_ADMIN_GITHUB_APP_NAME=
# STATSPARROT_ADMIN_GITHUB_APP_WEBHOOK_SECRET=
# STATSPARROT_ADMIN_GITHUB_CLIENT_ID=
# STATSPARROT_ADMIN_GITHUB_CLIENT_SECRET=
# STATSPARROT_ADMIN_GITHUB_MANAGED_ACCOUNT=

# ─── Logging ─────────────────────────────────────────────────────────────────
# STATSPARROT_SERVE_LOG_LEVEL=info
# STATSPARROT_ADMIN_LOG_LEVEL=info
# STATSPARROT_RUNTIME_LOG_LEVEL=info
